numpages = {18},
keywords = {Occupational stress, Parenting and caregiving, Boundary permeability, Attentional control, In-the-wild stress monitoring, Wearable sensing, Heart rate variability (HRV), Normalized heart rate (NHR), Frontline leadership, Boundary management technologies},
